{"kind":"statement","subkind":"theorem","paper":"1012.0963","version":"1","local":"theorem-1","file":"","number":"3.10","section":"sec-3","order":15,"title":"Theorem","body_md":"The graphs $H_i$ for $i=1,\\dots,30$ and those in ${\\mathcal\r\nG}_j$ for $j=1,\\dots,8$ are all connected tricyclic graphs with\r\nexactly two main eigenvalues.","path":"source","confidence":"certain","env":"theorem","item":"statement/theorem","head":"environment","counter":"theorem","number_from":"counter","scope":"paper","proof_status":"none","origin":"own","span":{"file":"mainnew420zhong11.tex","from":1216,"to":1219},"hash":"sha256:3a84fd46244e31d29bc6a99cd08a7965e28403719b3e5e86786d3cb5dd88814e","minhash":"","census":"1012.0963v1#env-15","extractor":"ax/v0.5.6"}
