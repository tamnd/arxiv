{"tag":"3SPR","kind":"statement","subkind":"lemma","paper":"2401.15490","version":"1","local":"lemma-2","file":"","label":"mylemma2","number":"3.4","section":"sec-3","order":8,"title":"Lemma","body_md":"\\label{mylemma2}\nIf a graph $G=(F_1^i \\left[p^i_1,p^i_2,p^i_3,p^i_4\\right] \\cup H)_{E'}$ has $\\varphi$ locally-balanced $2$-partition with an open neighborhood, then $\\varphi(p^i_1) = \\varphi(p^i_2) = \\varphi(p^i_3) = \\varphi(p^i_4)$.","path":"source","confidence":"certain","env":"lemma","item":"statement/lemma","head":"environment","counter":"theorem","number_from":"render","labels":["mylemma2"],"scope":"paper","proof_status":"none","origin":"own","span":{"file":"main.tex","from":337,"to":339},"hash":"sha256:c2c831d920541c732a633814135c04fd272c701936cab318ca1560363d4d0b5f","minhash":"","census":"2401.15490v1#env-8","extractor":"ax/v0.5.8"}
