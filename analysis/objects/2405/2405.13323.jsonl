{"tag":"2INU","kind":"statement","subkind":"theorem","paper":"2405.13323","version":"1","local":"theorem-1","file":"","number":"2.1","section":"sec-2","order":1,"title":"Theorem","body_md":"For $n\\ge k\\ge 0$, we have\r\n\\begin{displaymath}\r\nS_{2,\\lambda}^{(r,Y)}(n+r,k+r)=\\frac{1}{k!}\\sum_{j=0}^{k}\\binom{k}{j}(-1)^{k-j}E\\big[(S_{j+r})_{n,\\lambda}\\big].\r\n\\end{displaymath}","path":"source","confidence":"certain","env":"theorem","item":"statement/theorem","head":"environment","counter":"theorem","number_from":"render","scope":"paper","proof_status":"none","origin":"own","span":{"file":"paper.tex","from":172,"to":177},"hash":"sha256:0d60f3c5295ad50e9d20094c3c3957d1e033b86caa1cd189b49f6e4e937d7dbc","minhash":"","census":"2405.13323v1#env-1","extractor":"ax/v0.5.8"}
{"tag":"MO4X","kind":"statement","subkind":"theorem","paper":"2405.13323","version":"1","local":"theorem-2","file":"","number":"2.2","section":"sec-2","order":2,"title":"Theorem","body_md":"For $n\\ge k\\ge 0$, we have\r\n\\begin{displaymath}\r\nS_{2,\\lambda}^{(r,Y)}(n+r,k+r)=\\sum_{l=k}^{n}\\sum_{m=0}^{n-l}\\binom{n}{l}\\lambda^{n-m-l}S_{1}(n-l,m)S_{2,\\lambda}^{Y}(l,k)E\\big[S_{r}^{m}\\big].\r\n\\end{displaymath}","path":"source","confidence":"certain","env":"theorem","item":"statement/theorem","head":"environment","counter":"theorem","number_from":"render","scope":"paper","proof_status":"none","origin":"own","span":{"file":"paper.tex","from":186,"to":191},"hash":"sha256:f9ae210c2f7bb15744c3d2aae5f47610ddf5eb381dc6299d738d6cd25dac08e9","minhash":"","census":"2405.13323v1#env-2","extractor":"ax/v0.5.8"}
{"tag":"TTCF","kind":"statement","subkind":"theorem","paper":"2405.13323","version":"1","local":"theorem-3","file":"","number":"2.3","section":"sec-2","order":3,"title":"Theorem","body_md":"For $n,k\\ge 0$ with $n\\ge k$, we have\r\n\\begin{displaymath}\r\nS_{2,\\lambda}^{(r,Y)}(n+r,k+r)=\\sum_{m=0}^{n-k}\\binom{m+k}{m}\\binom{r}{m}m!S_{2,\\lambda}^{Y}(n,m+k).\r\n\\end{displaymath}","path":"source","confidence":"certain","env":"theorem","item":"statement/theorem","head":"environment","counter":"theorem","number_from":"render","scope":"paper","proof_status":"none","origin":"own","span":{"file":"paper.tex","from":201,"to":206},"hash":"sha256:f3650c6e7ba661f420f1bc9ccdfea98a4090f452f4753124d1603b6a49207b5f","minhash":"","census":"2405.13323v1#env-3","extractor":"ax/v0.5.8"}
{"tag":"705L","kind":"statement","subkind":"theorem","paper":"2405.13323","version":"1","local":"theorem-4","file":"","number":"2.4","section":"sec-2","order":4,"title":"Theorem","body_md":"For $n \\ge 0$, we have\r\n\\begin{displaymath}\r\n\\sum_{k=0}^{n}S_{2,\\lambda}^{(r,Y)}(n+r,k+r)(x)_{k}=\\sum_{k=0}^{n}S_{2,\\lambda}^{Y}(n,k)(x+r)_{k}.\r\n\\end{displaymath}","path":"source","confidence":"certain","env":"theorem","item":"statement/theorem","head":"environment","counter":"theorem","number_from":"render","scope":"paper","proof_status":"none","origin":"own","span":{"file":"paper.tex","from":221,"to":226},"hash":"sha256:8e75258a9e9a487b8321c52a9b14f522a506760b00470b71d4387b53a02fbc99","minhash":"","census":"2405.13323v1#env-4","extractor":"ax/v0.5.8"}
{"tag":"NJ2W","kind":"statement","subkind":"theorem","paper":"2405.13323","version":"1","local":"theorem-5","file":"","number":"2.5","section":"sec-2","order":5,"title":"Theorem","body_md":"For $n\\ge 0$, we have\r\n\\begin{displaymath}\r\n\\mathrm{Bel}_{n,\\lambda}^{(r,Y)}(x)=\\sum_{k=0}^{n}S_{2,\\lambda}^{(r,Y)}(n+r,k+r)x^{k}.\r\n\\end{displaymath}","path":"source","confidence":"certain","env":"theorem","item":"statement/theorem","head":"environment","counter":"theorem","number_from":"render","scope":"paper","proof_status":"none","origin":"own","span":{"file":"paper.tex","from":242,"to":247},"hash":"sha256:e70f3774a8db08f483691d230df340571b968663a7821e894415b841a8e9d856","minhash":"","census":"2405.13323v1#env-5","extractor":"ax/v0.5.8"}
{"tag":"F1IU","kind":"statement","subkind":"theorem","paper":"2405.13323","version":"1","local":"theorem-6","file":"","number":"2.6","section":"sec-2","order":6,"title":"Theorem","body_md":"For $n\\ge 0$, we have\r\n\\begin{displaymath}\r\n\\mathrm{Bel}_{n,\\lambda}^{(r,Y)}(x)=\\sum_{m=0}^{n}\\binom{n}{m}E\\big[(S_{r})_{m,\\lambda}\\big]\\mathrm{Bel}_{n-m,\\lambda}^{Y}(x).\r\n\\end{displaymath}","path":"source","confidence":"certain","env":"theorem","item":"statement/theorem","head":"environment","counter":"theorem","number_from":"render","scope":"paper","proof_status":"none","origin":"own","span":{"file":"paper.tex","from":255,"to":260},"hash":"sha256:05a4986ec95ba83ee2f986e36756b269562e8fafb958c451e70ea3a9d8906833","minhash":"","census":"2405.13323v1#env-6","extractor":"ax/v0.5.8"}
{"tag":"MNEB","kind":"statement","subkind":"theorem","paper":"2405.13323","version":"1","local":"theorem-7","file":"","number":"2.7","section":"sec-2","order":7,"title":"Theorem","body_md":"For $n\\ge 0$, we have\r\n\\begin{displaymath}\r\n\\mathrm{Bel}_{n,\\lambda}^{(r,Y)}(x)=e^{-x}\\sum_{k=0}^{\\infty}x^{k}\\frac{E[(S_{k+r})_{n,\\lambda}]}{k!}.\r\n\\end{displaymath}","path":"source","confidence":"certain","env":"theorem","item":"statement/theorem","head":"environment","counter":"theorem","number_from":"render","scope":"paper","proof_status":"none","origin":"own","span":{"file":"paper.tex","from":269,"to":274},"hash":"sha256:f672b1061fd112aba71d907ce3ece4ee41f1c07685fc513979204f835522f326","minhash":"","census":"2405.13323v1#env-7","extractor":"ax/v0.5.8"}
{"tag":"JE1B","kind":"statement","subkind":"theorem","paper":"2405.13323","version":"1","local":"theorem-8","file":"","number":"2.8","section":"sec-2","order":8,"title":"Theorem","body_md":"For $m,k\\ge 0$ with $n\\ge m+k$, we have\r\n\\begin{displaymath}\r\n\\binom{m+k}{m}S_{2,\\lambda}^{(r,Y)}(n+r,m+k+r)=\\sum_{l=m}^{n-k}\\binom{n}{l}S_{2,\\lambda}^{(r,Y)}(l+r,m+r)S_{2,\\lambda}^{Y}(n-l,k).\r\n\\end{displaymath}","path":"source","confidence":"certain","env":"theorem","item":"statement/theorem","head":"environment","counter":"theorem","number_from":"render","scope":"paper","proof_status":"none","origin":"own","span":{"file":"paper.tex","from":289,"to":294},"hash":"sha256:7105bfcc7951726af710eba32cf45b2424a4fa8ae5767052564469d6abf5427b","minhash":"","census":"2405.13323v1#env-8","extractor":"ax/v0.5.8"}
{"tag":"H7DK","kind":"statement","subkind":"theorem","paper":"2405.13323","version":"1","local":"theorem-9","file":"","number":"2.9","section":"sec-2","order":9,"title":"Theorem","body_md":"For $n \\ge 0$, we have\r\n\\begin{displaymath}\r\n\\sum_{k=0}^{n}S_{2,\\lambda}^{(r,Y)}(n+r,k+r)(x)_{k}= \\sum_{i=0}^{n}\\sum_{j=i}^{n}S_{1}(j,i)S_{2,\\lambda}^{Y}(n,i)(x+r)^{i}.\r\n\\end{displaymath}","path":"source","confidence":"certain","env":"theorem","item":"statement/theorem","head":"environment","counter":"theorem","number_from":"render","scope":"paper","proof_status":"none","origin":"own","span":{"file":"paper.tex","from":305,"to":310},"hash":"sha256:0437d149d1ee7215a72d68a201430cc942ac7a20cd8c45e8840f085f7a37afa4","minhash":"","census":"2405.13323v1#env-9","extractor":"ax/v0.5.8"}
